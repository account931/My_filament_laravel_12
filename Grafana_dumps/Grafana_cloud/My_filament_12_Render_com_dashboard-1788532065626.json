      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Laravel-12-Owners-ChatGTP-2",
          "description": "All owners list",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "dfx8s56ms4t1cb"
                      },
                      "spec": {
                        "dataset": "dima_laravel_filament",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  o.id AS owner_id,\n  o.first_name AS owner_name,\n  v.id AS venue_id,\n  v.venue_name AS venue_name,\n  e.id AS equipment_id,\n  e.trademark_name,\n  e.model_name\nFROM owners o\nJOIN venues v ON v.owner_id = o.id\nLEFT JOIN equipment_venue ev ON ev.venue_id = v.id\nLEFT JOIN equipments e ON e.id = ev.equipment_id\nORDER BY o.id, v.id, e.trademark_name;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
